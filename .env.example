# Copy these into your shell before running the pipeline or tests (see README "Run it").
# Placeholders only: never commit a real password. Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# The password below matches the docker command in the README; change both if you change one.

# Pipeline database: run_all.py loads the raw data here and builds every table from it.
DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/retail

# A separate, throwaway database: tests/test_sql_logic.py drops and rebuilds its tables on every test.
TEST_DATABASE_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/retail_test
